#!/data/data/com.termux/files/usr/bin/bash

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mylinux/terminal-battery"
STATE_FILE="$STATE_DIR/percent"

mkdir -p "$STATE_DIR"
umask 077

# First use always initializes the simulated battery to 0%.
if [ ! -f "$STATE_FILE" ]; then
    printf '0\n' > "$STATE_FILE"
fi

if [ "$#" -ne 1 ]; then
    echo "Usage: charge <0-100>"
    echo "Example: charge 22"
    exit 1
fi

case "$1" in
    ''|*[!0-9]*)
        echo "Error: enter a whole number from 0 to 100."
        exit 1
        ;;
esac

VALUE=$(printf '%s' "$1" | sed 's/^0*//')
[ -z "$VALUE" ] && VALUE=0

if [ "$VALUE" -gt 100 ]; then
    echo "Error: maximum simulated charge is 100%."
    exit 1
fi

TEMP_FILE="$STATE_FILE.tmp"
printf '%s\n' "$VALUE" > "$TEMP_FILE" &&
    mv "$TEMP_FILE" "$STATE_FILE"

echo "MyLinux Terminal Battery: ${VALUE}%"
