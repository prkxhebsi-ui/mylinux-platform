    bool "Kernel debugging"
    default y

config MYLINUX_DEBUG_MEMORY
    bool "Memory diagnostics"
    depends on MYLINUX_DEBUG
    default n

config MYLINUX_DEBUG_LOCKS
    bool "Lock diagnostics"
    depends on MYLINUX_DEBUG
