mainmenu "MyLinux Kernel Configuration - Lenovo A6000"

config MYLINUX_KERNEL
    bool
    default y

menu "General setup"

config LOCALVERSION
    string "Local version"
    default "-mylinux-a6000"

config LOCALVERSION_AUTO
    bool "Automatically append version information"
    default n

config 64BIT
    bool
    default n

config ARM
    bool
    default y

config SMP
    bool "Symmetric multiprocessing"
    default y

config NR_CPUS
    int "Maximum number of CPUs"
    range 1 4
    default 4

config HZ
    int "Timer frequency"
    range 100 1000
    default 250

config PRINTK
    bool "Enable kernel printk"
    default y

config IKCONFIG
    bool "Enable embedded kernel configuration"
    default y

config IKCONFIG_PROC
    bool "Expose kernel configuration through /proc/config.gz"
    depends on IKCONFIG
    default y

endmenu

menu "Memory management"

config MMU
    bool
    default y

config SWAP
    bool "Enable swap support"
    default y

config MEMORY_HOTPLUG
    bool "Memory hotplug support"
    default n

endmenu

menu "Executable formats"

config BINFMT_ELF
    bool "ELF executable support"
    default y

config BINFMT_SCRIPT
    bool "Script execution support"
    default y

endmenu

menu "Device drivers"

source "drivers/Kconfig"

endmenu

menu "File systems"

source "fs/Kconfig"

endmenu

menu "Networking"

source "net/Kconfig"

endmenu

menu "Security"

source "security/Kconfig"

endmenu

menu "Cryptographic API"

source "crypto/Kconfig"

endmenu

menu "Architecture configuration"

source "arch/arm/Kconfig"

endmenu
