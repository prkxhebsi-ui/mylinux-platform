package(default_visibility = ["//visibility:public"])

constraint_setting(name = "mylinux_os")
constraint_setting(name = "mylinux_arch")

constraint_value(
    name = "android",
    constraint_setting = ":mylinux_os",
)

constraint_value(
    name = "linux",
    constraint_setting = ":mylinux_os",
)

constraint_value(
    name = "arm64",
    constraint_setting = ":mylinux_arch",
)

constraint_value(
    name = "x86_64",
    constraint_setting = ":mylinux_arch",
)

platform(
    name = "android_arm64",
    constraint_values = [
        ":android",
        ":arm64",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        ":linux",
        ":arm64",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        ":linux",
        ":x86_64",
    ],
)
