// Initial MyLinux libcrypto build definition.
//
// This module is intentionally disabled until reviewed cryptographic
// implementations and complete API definitions are integrated.

cc_library_shared {
    name: "libcrypto_mylinux",
    srcs: [],
    export_include_dirs: ["include"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    compile_multilib: "64",
    enabled: false,
}
