package(default_visibility = ["//visibility:public"])

cc_library(
    name = "crypto_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)

cc_library(
    name = "crypto_core",
    srcs = [
        "src/crypto/version.c",
        "src/crypto/error.c",
    ],
    hdrs = glob(["src/crypto/*.h"]),
    deps = [":crypto_headers"],
    copts = ["-std=c11", "-Wall", "-Wextra"],
)

cc_library(
    name = "crypto_random",
    srcs = ["src/random/random.c"],
    hdrs = glob(["src/random/*.h"]),
    deps = [":crypto_headers"],
    copts = ["-std=c11", "-Wall", "-Wextra"],
)
